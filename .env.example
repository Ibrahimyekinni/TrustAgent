# Copy this to .env and fill in your values
# DO NOT commit .env to git

# Base Sepolia RPC
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer wallet private key (from MetaMask - export private key)
PRIVATE_KEY=your_wallet_private_key_here

# Schema UID (get this by running: npm run register-schema)
SCHEMA_UID=your_schema_uid_here
