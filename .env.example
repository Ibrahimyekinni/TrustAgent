# Copy this to .env and fill in your values
# DO NOT commit .env to git

# Base Sepolia RPC
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer wallet private key (from MetaMask - export private key)
PRIVATE_KEY=your_wallet_private_key_here

# Schema UIDs (get V1 by running: npm run register-schema)
# V1: address freelancer, string projectName, uint8 rating, string review
SCHEMA_UID=your_v1_schema_uid_here
# V2: adds string proofURI for proof-of-work links
SCHEMA_UID_V2=your_v2_schema_uid_here

# Validation schema UID (registered by scripts/registerValidationSchema.js)
SCHEMA_UID_VALIDATION=your_validation_schema_uid_here

# TrustAgent's own ERC-8004 agent ID (registered by scripts/registerAgent.js)
TRUSTAGENT_AGENT_ID=your_agent_id_here

# Anthropic API key (required -- powers trust analysis and agent validation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# TrustEnforcer contract address (deployed by scripts/deployTrustEnforcer.js)
TRUST_ENFORCER_ADDRESS=your_trust_enforcer_address_here

# Synthesis Hackathon API key (optional)
SYNTHESIS_API_KEY=your_synthesis_api_key_here
