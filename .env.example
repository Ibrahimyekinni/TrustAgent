# Copy this to .env and fill in your values
# DO NOT commit .env to git

# Base Sepolia RPC
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer wallet private key (from MetaMask - export private key)
PRIVATE_KEY=your_wallet_private_key_here

# Schema UIDs (get V1 by running: npm run register-schema)
# V1: address freelancer, string projectName, uint8 rating, string review
SCHEMA_UID=your_v1_schema_uid_here
# V2: adds string proofURI for proof-of-work links
SCHEMA_UID_V2=your_v2_schema_uid_here

# Anthropic API key (optional -- enables Claude-powered natural language understanding)
# Without this, the agent falls back to regex-based pattern matching
ANTHROPIC_API_KEY=your_anthropic_api_key_here
